<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bluee1"
    tools:context=".AjoutCandidat">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="MissingConstraints" >


        <ImageView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="20dp"
            app:srcCompat="@drawable/ajouter2" />

        <EditText
            android:id="@+id/enom"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="35sp"
            android:layout_marginTop="25sp"
            android:layout_marginBottom="20sp"
            android:background="#30ffffff"
            android:drawablePadding="20dp"
            android:inputType="text"
            android:hint="Nom"
            android:padding="20dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="82dp"
            tools:layout_editor_absoluteY="112dp" />

        <EditText
            android:id="@+id/eprenom"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:background="#30ffffff"
            android:drawablePadding="20dp"
            android:ems="10"
            android:hint="Prénom"
            android:layout_marginTop="20sp"
            android:layout_marginLeft="35sp"
            android:layout_marginBottom="20sp"
            android:inputType="text"
            android:padding="20dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="55dp"
            tools:layout_editor_absoluteY="202dp" />



        <Button
            android:id="@+id/datePickernaiss"
            style="?android:spinnerStyle"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="35sp"
            android:layout_marginBottom="20sp"
            android:background="#30ffffff"
            android:onClick="openDatePicker"
            android:text=" Date de naissance"


            android:textSize="20sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView"
            android:padding="20dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white"

            tools:layout_editor_absoluteX="55dp"
            tools:layout_editor_absoluteY="202dp" />


        <EditText
            android:id="@+id/lieun"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:background="#30ffffff"
            android:drawablePadding="20dp"
            android:ems="10"
            android:hint="Lieu de naissance"
            android:layout_marginTop="20sp"
            android:layout_marginLeft="35sp"
            android:layout_marginBottom="20sp"
            android:inputType="text"
            android:padding="20dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="55dp"
            tools:layout_editor_absoluteY="202dp" />

        <RadioGroup
            android:id="@+id/radio_group_gender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <RadioButton
                android:id="@+id/radio_button_male"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="65dp"
                android:textSize="18dp"
                android:textColor="@color/white"
                android:text="Homme" />


            <RadioButton
                android:id="@+id/radio_button_female"
                android:layout_width="113dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="72dp"
                android:text="Femme"
                android:textColor="@color/white"
                android:textSize="18dp" />
        </RadioGroup>

        <EditText
            android:id="@+id/adress"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:background="#30ffffff"
            android:drawablePadding="20dp"
            android:ems="10"
            android:hint="Adresse"
            android:layout_marginTop="20sp"
            android:layout_marginLeft="35sp"
            android:layout_marginBottom="20sp"
            android:inputType="text"
            android:padding="20dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="55dp"
            tools:layout_editor_absoluteY="202dp" />

        <EditText
            android:id="@+id/tlf"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:background="#30ffffff"
            android:drawablePadding="20dp"
            android:ems="10"
            android:hint="Téléphone"
            android:layout_marginTop="20sp"
            android:layout_marginLeft="35sp"
            android:layout_marginBottom="20sp"
            android:inputType="number"
            android:padding="20dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="55dp"
            tools:layout_editor_absoluteY="202dp" />

        <EditText
            android:id="@+id/username"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:background="#30ffffff"
            android:drawablePadding="20dp"
            android:ems="10"
            android:hint="Nom utilisateur"
            android:layout_marginTop="20sp"
            android:layout_marginLeft="35sp"
            android:layout_marginBottom="20sp"
            android:inputType="text"
            android:padding="20dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="55dp"
            tools:layout_editor_absoluteY="202dp" />

        <EditText
            android:id="@+id/password"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:background="#30ffffff"
            android:drawablePadding="20dp"
            android:ems="10"
            android:hint="Mot de passe"
            android:layout_marginTop="20sp"
            android:layout_marginLeft="35sp"
            android:layout_marginBottom="20sp"
            android:inputType="text"
            android:padding="20dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="55dp"
            tools:layout_editor_absoluteY="202dp" />

        <EditText
            android:id="@+id/montp"

            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:background="#30ffffff"
            android:drawablePadding="20dp"
            android:ems="10"
            android:hint="Montant payé"
            android:layout_marginTop="20sp"
            android:layout_marginLeft="35sp"
            android:layout_marginBottom="20sp"
            android:inputType="number"
            android:padding="20dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="55dp"
            tools:layout_editor_absoluteY="202dp" />


        <EditText
            android:id="@+id/montr"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:background="#30ffffff"
            android:drawablePadding="20dp"
            android:ems="10"
            android:hint="Montant restant"
            android:layout_marginTop="20sp"
            android:layout_marginLeft="35sp"
            android:layout_marginBottom="20sp"
            android:inputType="number"
            android:padding="20dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="55dp"
            tools:layout_editor_absoluteY="202dp" />


        <Button
            android:id="@+id/ajoucan"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Ajouter"
            android:backgroundTint="@color/bluee"
            android:layout_marginLeft="110dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            />





    </LinearLayout>

</ScrollView>