<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/bluee1">
    <androidx.cardview.widget.CardView
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        app:cardBackgroundColor="@color/bluee2">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/imageek"
                android:layout_width="100dp"
                android:layout_height="170dp"

                android:layout_marginStart="16dp"
                android:src="@drawable/calendar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/id2"
                    android:layout_width="100dp"
                    android:layout_height="34dp"
                    android:text="ID:"
                    android:textColor="@color/bluee4" />


                <TextView
                    android:id="@+id/idnom2"
                    android:layout_width="100dp"
                    android:layout_height="34dp"
                    android:text="Nom:"
                    android:textColor="@color/bluee4" />

                <TextView
                    android:id="@+id/idprenom2"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:text="Prenom:"
                    android:textColor="@color/bluee4" />





                <TextView
                    android:id="@+id/iddate2"
                    android:layout_width="match_parent"
                    android:layout_height="29dp"
                    android:text="date :"
                    android:textColor="@color/bluee4" />

                <TextView
                    android:id="@+id/idtype2"
                    android:layout_width="match_parent"
                    android:layout_height="29dp"
                    android:text="type: "
                    android:textColor="@color/bluee4" />

                <TextView
                    android:id="@+id/idheure2"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:text="heure:"
                    android:textColor="@color/bluee4"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/Editexm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/boutonmodifier"
                    android:background="@color/bluee2"
                    android:padding="30dp"
                    />
                    <ImageButton
                        android:id="@+id/supp2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/boutonsupprimer"
                        android:background="@color/bluee2"
                        android:padding="30dp"
                       />
                </LinearLayout>


            </LinearLayout>



        </LinearLayout>

    </androidx.cardview.widget.CardView>






</RelativeLayout>