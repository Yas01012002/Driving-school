<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/bluee1">
    <androidx.cardview.widget.CardView
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true"
        android:layout_width="match_parent"
        android:layout_height="270dp"
        app:cardBackgroundColor="@color/bluee2">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">


        <ImageView
            android:id="@id/image"
            android:layout_width="100dp"
            android:layout_height="200dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp"
            android:src="@drawable/task" />

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">


            <TextView
                android:id="@+id/id1"
                android:layout_width="100dp"
                android:layout_height="34dp"
                android:text="ID:"
                android:textColor="@color/bluee4" />

            <TextView
                android:id="@+id/idnom1"
                android:layout_width="100dp"
                android:layout_height="34dp"
                android:text="Nom:"
                android:textColor="@color/bluee4" />

            <TextView
                android:id="@+id/idprenom1"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:text="Prenom:"
                android:textColor="@color/bluee4" />





            <TextView
                android:id="@+id/iddate"
                android:layout_width="match_parent"
                android:layout_height="29dp"
                android:text="date :"
                android:textColor="@color/bluee4" />

            <TextView
            android:id="@+id/idtype"
            android:layout_width="match_parent"
            android:layout_height="29dp"
            android:text="type: "
                android:textColor="@color/bluee4" />

             <TextView
                android:id="@+id/idheure"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:text="heure:"
                 android:textColor="@color/bluee4"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/Editcour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/bluee2"
                    android:padding="30dp"
                    android:src="@drawable/boutonmodifier" />

                <ImageButton
                    android:id="@+id/supp1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/boutonsupprimer"
                    android:background="@color/bluee2"
                    android:padding="30dp"/>
            </LinearLayout>


        </LinearLayout>




      </LinearLayout>

    </androidx.cardview.widget.CardView>






   </RelativeLayout>